# Python
venv/
__pycache__/
*.pyc
*.pyo

# Environment & secrets (never commit)
.env
.env.local
.env.*.local

# Application data (secrets, database)
data/config.json
config.json
# Trailing wildcard so sidecars and hand-made copies are covered too:
# "*.db" alone misses .db-wal, .db-shm and .db.bak, which carry the same
# customer data as the database itself.
*.db*

# Generated docs site
site/

# IDE / tooling
.claude/
.vscode/
.idea/
*.swp
*.swo
