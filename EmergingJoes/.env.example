# JOES Threat Intelligence — environment configuration
# Copy this file to .env and fill in the values you need.
# DO NOT commit .env to version control.
#
# Secret values are intentionally left BLANK rather than filled with
# placeholders. A placeholder like "your-openai-api-key-here" is a non-empty
# string, so the app would report a configured provider and only fail later
# with an auth error; a placeholder NOTIFICATION_EMAIL would likewise switch
# email notifications on by itself. Leave a line blank unless you have a real
# value for it.
#
# Everything here can also be set in the Settings UI, which is the easier path.
# Note that an environment variable set below OVERRIDES the UI, so a stale
# value here cannot be changed from Settings.

# Application
HOST=127.0.0.1
PORT=5050
DATA_DIR=./data

# LLM provider selection: "openai" | "anthropic" | "openrouter" | "gemini"
# Leave blank to choose it in Settings instead.
LLM_PROVIDER=

# OpenAI (chat + embeddings). Also the embeddings fallback for Anthropic and
# OpenRouter, which have no embeddings endpoint of their own; without it those
# two lose semantic search, RAG chat and digest clustering. Gemini does not
# need this, as it embeds with its own key.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenRouter (OpenAI-compatible).
# Pin a concrete ":free" model, not the "openrouter/free" alias — the alias
# routes to an arbitrary free model per call, and they differ in JSON-mode
# support, which breaks structured responses mid-pipeline.
# Free tier: 20 requests/minute and 50 requests/UTC-day until $10 of credits
# has been purchased, after which the daily cap rises to 1,000.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Gemini, via Google's OpenAI-compatible endpoint (no extra SDK needed).
# Key comes from Google AI Studio (https://aistudio.google.com/apikey); no
# billing account is required, since Flash and Flash-Lite are on the free tier.
# GOOGLE_API_KEY is accepted as an alias, for parity with the Google SDKs.
# Free quotas are per project and Google changes them without notice, so check
# your live limits in AI Studio before a large backfill.
GEMINI_API_KEY=
# Prefer the "-latest" alias: Google keeps retired ids in the model listing,
# and they only fail at call time with a 404.
# GEMINI_MODEL=gemini-flash-lite-latest

# Malpedia API (optional) — adds Malpedia's curated threat-research library.
MALPEDIA_API_KEY=

# MISP (optional — also configurable in Settings)
# MISP_URL=https://127.0.0.1:8443
# MISP_KEY=

# Slack advisory distribution (optional — also configurable in Settings).
# Bot token (xoxb-...) or user token (xoxp-...) with chat:write, files:write,
# channels:read, groups:read. A user token needs them under "User Token
# Scopes"; a bot token under "Bot Token Scopes".
SLACK_BOT_TOKEN=

# Email notifications (optional).
# Setting NOTIFICATION_EMAIL enables email notifications, so leave it blank
# unless you want them on.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
